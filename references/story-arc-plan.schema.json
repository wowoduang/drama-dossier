{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drama Dossier Cross-Episode Story Arc Plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "series_id",
    "goal",
    "sequence_strategy",
    "viewpoint",
    "required_roles",
    "segments",
    "continuity_links",
    "review_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "viewpoint": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "VIEWER",
            "CHARACTER"
          ]
        },
        "character_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sequence_strategy": {
      "enum": [
        "CHRONOLOGICAL",
        "EDITORIAL_NONLINEAR"
      ]
    },
    "reorder_reason": {
      "type": "string"
    },
    "target_duration_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "required_roles": {
      "type": "array",
      "items": {
        "enum": [
          "setup",
          "inciting_incident",
          "escalation",
          "peak",
          "reaction",
          "payoff",
          "resolution",
          "bridge"
        ]
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "role",
          "episode_id",
          "event_ids",
          "rationale"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "setup",
              "inciting_incident",
              "escalation",
              "peak",
              "reaction",
              "payoff",
              "resolution",
              "bridge"
            ]
          },
          "episode_id": {
            "type": "string"
          },
          "event_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "connection_note": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^:]+:.+$"
            }
          },
          "review_status": {
            "enum": [
              "UNREVIEWED",
              "PASS",
              "NEED_EVIDENCE",
              "INCORRECT",
              "DISPUTED"
            ]
          }
        }
      }
    },
    "continuity_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_event",
          "to_event",
          "basis"
        ],
        "properties": {
          "from_event": {
            "type": "string",
            "pattern": "^[^:]+:.+$"
          },
          "to_event": {
            "type": "string",
            "pattern": "^[^:]+:.+$"
          },
          "basis": {
            "enum": [
              "CROSS_EPISODE_CAUSAL",
              "LOCAL_CAUSAL",
              "SAME_STORYLINE",
              "SAME_THREAD",
              "SHARED_CHARACTER",
              "HUMAN_CONTEXT"
            ]
          },
          "edge_id": {
            "type": "string"
          },
          "storyline_id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          },
          "character_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_status": {
            "enum": [
              "UNREVIEWED",
              "PASS",
              "NEED_EVIDENCE",
              "INCORRECT",
              "DISPUTED"
            ]
          }
        }
      }
    },
    "missing_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "enum": [
        "UNREVIEWED",
        "PASS",
        "NEED_EVIDENCE",
        "INCORRECT",
        "DISPUTED"
      ]
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "spoiler_guard": {
      "type": "object",
      "description": "Strict as-of-episode spoiler boundary. Cross-episode links require a human-audited series_visibility declaration effective no later than this episode.",
      "required": [
        "enabled",
        "max_episode_number"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "max_episode_number": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
